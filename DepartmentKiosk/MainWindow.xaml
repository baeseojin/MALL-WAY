<Window x:Class="DepartmentKiosk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding MallName}" Width="1280" Height="760" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen" FontFamily="Malgun Gothic" Background="#F1F5F9">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="MapPanel">
            <Canvas />
        </ItemsPanelTemplate>
        <Style x:Key="MapPosition" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding X}" />
            <Setter Property="Canvas.Top" Value="{Binding Y}" />
        </Style>
        <Style x:Key="SidebarHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#93B5D2" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="200" />
        </Grid.ColumnDefinitions>

        <Border Background="#10243A" Padding="23,32">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="ARON  /  DIRECTORY" Style="{StaticResource SidebarHeading}" />
                    <TextBlock Text="{Binding MallName}" Foreground="White" FontSize="23" FontWeight="Bold" />
                    <TextBlock Text="백화점 층별 안내" Foreground="#C4D8EA" Margin="0,8,0,32" />
                    <TextBlock Text="층별 구성" Style="{StaticResource SidebarHeading}" />
                    <Border Background="#235274" CornerRadius="8" Padding="13" Margin="0,0,0,12">
                        <TextBlock Text="{Binding FloorTitle}" Foreground="White" FontSize="17" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="{Binding KioskFloorLabel}" Foreground="#C4D8EA" Margin="0,3,0,0" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="ARON DEPARTMENT STORE" Foreground="#93B5D2" FontSize="11" />
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="26,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="FLOOR GUIDE" Foreground="#526980" FontSize="12" FontWeight="Bold" />
                <TextBlock Text="{Binding FloorTitle}" FontSize="34" FontWeight="Bold" Foreground="#10243A" />
            </StackPanel>

            <Border Grid.Row="1" Background="White" BorderBrush="#D7E2EA" BorderThickness="1"
                    CornerRadius="15" Padding="12">
                <Viewbox Stretch="Uniform">
                    <Grid Width="680" Height="480">
                        <Border Background="#EDF3F7" CornerRadius="16" Margin="10,30" />
                        <Canvas>
                            <Rectangle Canvas.Left="38" Canvas.Top="210" Width="604" Height="50"
                                       RadiusX="15" RadiusY="15" Fill="White" />
                            <Rectangle Canvas.Left="103" Canvas.Top="168" Width="44" Height="166" Fill="White" />
                            <Rectangle Canvas.Left="318" Canvas.Top="168" Width="44" Height="166" Fill="White" />
                            <Rectangle Canvas.Left="533" Canvas.Top="168" Width="44" Height="166" Fill="White" />
                        </Canvas>
                        <ItemsControl ItemsSource="{Binding Map.Places}" ItemsPanel="{StaticResource MapPanel}"
                                      ItemContainerStyle="{StaticResource MapPosition}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{Binding Width}" Height="{Binding Height}" CornerRadius="10"
                                            BorderBrush="#C4D5DE" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#DFEAF5" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Category}" Value="식당">
                                                        <Setter Property="Background" Value="#F6E7CB" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="카페">
                                                        <Setter Property="Background" Value="#DAEBDC" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Category}" HorizontalAlignment="Center"
                                                       Foreground="#435F76" FontSize="12" />
                                            <TextBlock Text="{Binding Name}" HorizontalAlignment="Center"
                                                       Foreground="#10243A" FontSize="17" FontWeight="Bold" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Map.Markers}" ItemsPanel="{StaticResource MapPanel}"
                                      ItemContainerStyle="{StaticResource MapPosition}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="168" Height="32">
                                        <Grid.RenderTransform>
                                            <TranslateTransform X="-84" Y="-16" />
                                        </Grid.RenderTransform>
                                        <Border Padding="11,4" CornerRadius="15" HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#245678" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsKiosk}" Value="True">
                                                            <Setter Property="Background" Value="#B92D3F" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Label}" Foreground="White" FontSize="13"
                                                       FontWeight="Bold" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Viewbox>
            </Border>

            <TextBlock Grid.Row="2" Text="지도에서 매장과 편의시설 위치를 확인하세요."
                       Foreground="#526980" FontSize="13" Margin="0,13,0,0" />
        </Grid>

        <Border Grid.Column="2" Background="#19334B" Padding="20,32">
            <StackPanel>
                <TextBlock Text="지도 범례" Style="{StaticResource SidebarHeading}" />
                <TextBlock Foreground="White" FontSize="15" Margin="0,7,0,15">
                    <Run Foreground="#FF8694" Text="●" /><Run Text="  현재 위치" />
                </TextBlock>
                <TextBlock Foreground="White" FontSize="15" Margin="0,0,0,15">
                    <Run Foreground="#9CCAF0" Text="●" /><Run Text="  엘리베이터" />
                </TextBlock>
                <TextBlock Foreground="White" FontSize="15">
                    <Run Foreground="#9CCAF0" Text="●" /><Run Text="  에스컬레이터" />
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
