<Window x:Class="MallWay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding MallName}" Width="1360" Height="820" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" FontFamily="Malgun Gothic" Background="#F1F5F9">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <ItemsPanelTemplate x:Key="MapPanel"><Canvas /></ItemsPanelTemplate>
        <Style x:Key="MapPosition" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding X}" />
            <Setter Property="Canvas.Top" Value="{Binding Y}" />
        </Style>
        <Style x:Key="SidebarHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9DBCD5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="TouchButton" TargetType="Button">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="#24445F" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#4B6E88" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#F0A441" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlaceButton" TargetType="Button" BasedOn="{StaticResource TouchButton}">
            <Setter Property="Background" Value="#DFEAF5" />
            <Setter Property="Foreground" Value="#10243A" />
            <Setter Property="BorderBrush" Value="#C4D5DE" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Category}" Value="식당">
                    <Setter Property="Background" Value="#F6E7CB" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="카페">
                    <Setter Property="Background" Value="#DAEBDC" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#FFE3A8" />
                    <Setter Property="BorderBrush" Value="#AD6500" />
                    <Setter Property="BorderThickness" Value="3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="285" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="250" />
        </Grid.ColumnDefinitions>

        <Border Background="#10243A" Padding="20,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="MALL-WAY  /  DIRECTORY" Style="{StaticResource SidebarHeading}" />
                    <TextBlock Text="{Binding MallName}" Foreground="White" FontSize="25" FontWeight="Bold" />
                    <TextBlock Text="매장 검색" Style="{StaticResource SidebarHeading}" Margin="0,22,0,8" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="17"
                             Padding="9" MinHeight="44" VerticalContentAlignment="Center"
                             AutomationProperties.Name="매장명 검색" />
                    <TextBlock Text="브랜드명 또는 시설명을 입력하세요." Foreground="#B8CFE1"
                               FontSize="11" Margin="0,6,0,12" />
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                              FontSize="15" MinHeight="40" Padding="6"
                              AutomationProperties.Name="카테고리 선택" />
                    <Button Content="검색 초기화" Command="{Binding ResetSearchCommand}"
                            Style="{StaticResource TouchButton}" Margin="0,10,0,0" />
                </StackPanel>
                <TextBlock Grid.Row="1" Text="{Binding ResultsSummary}" Foreground="#B8CFE1"
                           FontSize="13" Margin="0,18,0,10" />
                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding SearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource TouchButton}" Margin="0,0,5,8"
                                            HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.SelectPlaceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Width="190">
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding FloorLabel}" Foreground="#C5D9E9" FontSize="12" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="검색 결과가 없습니다.&#10;검색어나 카테고리를 바꿔 보세요."
                               Foreground="#C5D9E9" TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="{Binding HasNoResults, Converter={StaticResource VisibleWhenTrue}}" />
                </Grid>
                <TextBlock Grid.Row="3" Text="{Binding KioskFloorLabel}" Foreground="#9DBCD5"
                           FontSize="12" Margin="0,14,0,0" />
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="22,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="FLOOR GUIDE" Foreground="#526980" FontSize="12" FontWeight="Bold" />
            <Grid Grid.Row="1" Margin="0,5,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding FloorTitle}" FontSize="30" FontWeight="Bold" Foreground="#10243A" />
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Floors}" Margin="0,12,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}" Margin="0,0,8,0" Style="{StaticResource TouchButton}"
                                    Command="{Binding DataContext.ChangeFloorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            <Border Grid.Row="2" Background="White" BorderBrush="#D7E2EA" BorderThickness="1"
                    CornerRadius="15" Padding="10">
                <Viewbox Stretch="Uniform">
                    <Grid Width="680" Height="480">
                        <Border Background="#EDF3F7" CornerRadius="16" Margin="10,30" />
                        <Canvas>
                            <Rectangle Canvas.Left="38" Canvas.Top="210" Width="604" Height="50"
                                       RadiusX="15" RadiusY="15" Fill="White" />
                            <Rectangle Canvas.Left="103" Canvas.Top="168" Width="44" Height="166" Fill="White" />
                            <Rectangle Canvas.Left="318" Canvas.Top="168" Width="44" Height="166" Fill="White" />
                            <Rectangle Canvas.Left="533" Canvas.Top="168" Width="44" Height="166" Fill="White" />
                        </Canvas>
                        <ItemsControl ItemsSource="{Binding Map.Places}" ItemsPanel="{StaticResource MapPanel}"
                                      ItemContainerStyle="{StaticResource MapPosition}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="{Binding Width}" Height="{Binding Height}" Style="{StaticResource PlaceButton}"
                                            Command="{Binding DataContext.SelectPlaceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" ToolTip="{Binding Name}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Category}" HorizontalAlignment="Center"
                                                       Foreground="#435F76" FontSize="12" />
                                            <TextBlock Text="{Binding Name}" HorizontalAlignment="Center"
                                                       FontSize="17" FontWeight="Bold" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Map.Markers}" ItemsPanel="{StaticResource MapPanel}"
                                      ItemContainerStyle="{StaticResource MapPosition}" IsHitTestVisible="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="168" Height="32">
                                        <Grid.RenderTransform><TranslateTransform X="-84" Y="-16" /></Grid.RenderTransform>
                                        <Border Padding="11,4" CornerRadius="15" HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#245678" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsKiosk}" Value="True">
                                                            <Setter Property="Background" Value="#B92D3F" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Label}" Foreground="White" FontSize="13"
                                                       FontWeight="Bold" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Viewbox>
            </Border>
            <TextBlock Grid.Row="3" Text="매장을 누르면 위치와 영업정보를 확인할 수 있습니다."
                       Foreground="#526980" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" />
            <TextBlock Grid.Row="4" Text="{Binding ErrorMessage}" Foreground="#B92D3F" FontSize="13"
                       TextWrapping="Wrap" Margin="0,6,0,0" />
        </Grid>

        <Border Grid.Column="2" Background="#19334B" Padding="20,24">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="매장 · 시설 상세" Style="{StaticResource SidebarHeading}" />
                    <TextBlock Text="지도 또는 검색 결과에서&#10;목적지를 선택해 주세요." Foreground="#C5D9E9"
                               FontSize="14" Margin="0,0,0,12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers><DataTrigger Binding="{Binding HasSelection}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource VisibleWhenTrue}}">
                        <TextBlock Text="{Binding SelectedPlace.Name}" Foreground="White" FontSize="23"
                                   FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedPlace.Category}" Foreground="#C5D9E9" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding SelectedPlace.FloorLabel}" Foreground="White" FontSize="15" Margin="0,14,0,0" />
                        <TextBlock Text="영업시간" Style="{StaticResource SidebarHeading}" Margin="0,16,0,5" />
                        <TextBlock Text="{Binding SelectedPlace.Hours}" Foreground="White" FontSize="16" />
                        <Button Content="길찾기" Style="{StaticResource TouchButton}" Margin="0,16,0,0"
                                IsEnabled="False" ToolTip="경로 안내 준비 중" ToolTipService.ShowOnDisabled="True" />
                        <TextBlock Text="경로 안내 준비 중" Foreground="#B8CFE1" FontSize="12" Margin="0,6,0,0" />
                    </StackPanel>

                    <TextBlock Text="편의시설 바로 찾기" Style="{StaticResource SidebarHeading}" Margin="0,28,0,10" />
                    <Button Content="화장실" Command="{Binding FindFacilityCommand}" CommandParameter="화장실"
                            Style="{StaticResource TouchButton}" Margin="0,0,0,8" />
                    <Button Content="수유실" Command="{Binding FindFacilityCommand}" CommandParameter="수유실"
                            Style="{StaticResource TouchButton}" Margin="0,0,0,8" />
                    <Button Content="고객센터" Command="{Binding FindFacilityCommand}" CommandParameter="고객센터"
                            Style="{StaticResource TouchButton}" Margin="0,0,0,8" />
                    <Button Content="주차장 연결 통로" Command="{Binding FindFacilityCommand}" CommandParameter="주차장 연결 통로"
                            Style="{StaticResource TouchButton}" />
                    <TextBlock Text="결과 목록에서 원하는 층의&#10;시설을 선택하세요." Foreground="#B8CFE1"
                               FontSize="11" Margin="0,8,0,0" />

                    <TextBlock Text="지도 범례" Style="{StaticResource SidebarHeading}" Margin="0,26,0,10" />
                    <TextBlock Text="●  현재 위치 (1층)" Foreground="#FF9AA4" Margin="0,0,0,8" />
                    <TextBlock Text="●  선택한 목적지" Foreground="#FFE3A8" Margin="0,0,0,8" />
                    <TextBlock Text="●  엘리베이터 · 에스컬레이터" Foreground="#C5D9E9" FontSize="12" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
